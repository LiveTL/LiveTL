{
  "name": "@livetl/livetl",
  "version": "9.0.0",
  "description": "Get live translations for YouTube and Twitch streams, crowdsourced from multilingual viewers!",
  "scripts": {
    "build": "npm run type:check && npm run build:chrome && npm run build:firefox && npm run build:mv2 && npm run verify:build",
    "build:chrome": "cross-env BROWSER=chrome vite build",
    "build:firefox": "cross-env BROWSER=firefox vite build",
    "build:mv2": "cross-env BROWSER=firefox MV=2 vite build",
    "build:production": "npm run build",
    "codex:status": "bash scripts/codex-dev.sh status",
    "codex:test": "bash scripts/codex-dev.sh go-test",
    "codex:watch": "bash scripts/codex-dev.sh watch",
    "package": "npm run verify:build && node utils/package.js",
    "start": "npm run dev:chrome",
    "dev:chrome": "cross-env MINIFY=false BROWSER=chrome vite build --watch",
    "dev:firefox": "cross-env MINIFY=false BROWSER=firefox vite build --watch",
    "dev:mv2": "cross-env MINIFY=false BROWSER=firefox MV=2 vite build --watch",
    "ss": "node utils/screenshot.js",
    "update:list": "node utils/genlist.js",
    "type:check": "tsc -p tsconfig.json",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "npm run build:production && npm run package && cp dist/LiveTL-Firefox.zip dist/LiveTL-Firefox.xpi",
    "e2e:test": "pytest --tests-per-worker auto e2e",
    "e2e": "npm run e2e:build && npm run e2e:test",
    "format": "eslint --config ../../eslint.config.js --cache --fix .",
    "format:check": "eslint --config ../../eslint.config.js . --max-warnings=0",
    "check": "npm run format:check && npm run type:check && npm run test"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "6.0.3",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^13.2.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/chrome": "0.0.193",
    "@types/youtube": "^0.0.45",
    "autoprefixer": "10.5.4",
    "cross-env": "^7.0.3",
    "playwright-core": "^1.58.2",
    "postcss": "8.5.25",
    "request": "2.88.2",
    "rollup-plugin-copy": "3.5.0",
    "sha-1": "^1.0.0",
    "svelte": "5.56.8",
    "svelte-preprocess": "6.0.5",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "4.1.10",
    "jsdom": "29.1.1",
    "ws": "^7.5.0",
    "xvfb": "^0.4.0"
  },
  "dependencies": {
    "@livetl/svelte-webext-stores": "^0.0.14",
    "@mdi/js": "6.9.96",
    "dns-packet": "^5.4.0",
    "file-saver": "^2.0.5",
    "hosted-git-info": "^4.0.2",
    "html2canvas": "^1.0.0-rc.7",
    "iframe-translator": "0.3.8",
    "is-dark-color": "^1.2.0",
    "jquery": "^3.6.0",
    "jquery-ui-bundle": "^1.12.1-migrate",
    "reconnecting-eventsource": "^1.1.0",
    "youtube-iframe": "^1.0.3",
    "yt-iframe-noremote": "^1.0.0"
  }
}
