{
  "name": "@livetl/hyperchat",
  "version": "3.2.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm-run-all --parallel build:chrome build:firefox build:mv2 && npm run verify:build",
    "build:chrome": "cross-env BROWSER=chrome vite build",
    "build:firefox": "cross-env BROWSER=firefox vite build",
    "build:mv2": "cross-env BROWSER=firefox MV=2 vite build",
    "dev:chrome": "cross-env MINIFY=false BROWSER=chrome vite build --watch",
    "dev:firefox": "cross-env MINIFY=false BROWSER=firefox vite build --watch",
    "dev:mv2": "cross-env MINIFY=false BROWSER=firefox MV=2 vite build --watch",
    "verify:build": "node scripts/verify-build.mjs",
    "start": "npm run dev:chrome",
    "start:none": "npm run dev:chrome",
    "start:chrome": "cross-env AUTOLAUNCH=true npm run dev:chrome",
    "start:firefox": "cross-env AUTOLAUNCH=true npm run dev:firefox",
    "format:check": "npm run format -- --check",
    "format": "oxfmt",
    "lint": "npm run lint:check -- --fix",
    "lint:check": "eslint . --max-warnings=0",
    "check": "npm run format:check && npm run lint:check && npm run typecheck"
  },
  "dependencies": {
    "@livetl/svelte-webext-stores": "^0.0.14",
    "@mdi/js": "6.9.96",
    "iframe-translator": "0.3.8",
    "is-dark-color": "^1.2.0",
    "sha-1": "^1.0.0",
    "smelte": "^1.1.8",
    "svelte": "3.59.2",
    "tailwindcss": "2.2.19"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "4.1.3",
    "@sveltejs/vite-plugin-svelte": "1.4.0",
    "@tsconfig/svelte": "^2.0.1",
    "@types/chrome": "0.0.193",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "8.57.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-svelte3": "^3.2.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.61.0",
    "postcss": "8.5.25",
    "postcss-extend": "^1.0.5",
    "postcss-import": "14.1.0",
    "postcss-input-range": "^4.0.0",
    "postcss-preset-env": "^6.7.0",
    "postcss-url": "^10.1.3",
    "rollup-plugin-copy": "^3.4.0",
    "svelte-preprocess": "4.10.7",
    "terser": "^5.19.2",
    "typescript": "4.7.4",
    "vite": "3.2.11",
    "vite-plugin-web-extension": "1.4.9",
    "vite-plugin-zip-pack": "1.0.7"
  }
}
