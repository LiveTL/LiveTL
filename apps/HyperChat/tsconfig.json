{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "outDir": "./build/",
    "ignoreDeprecations": "6.0",
    "types": ["chrome", "node"],
    "strict": true,
    "lib": ["DOM"],
    "target": "ES2017"
  },
  "include": ["src/**/*", "*.js", "utils/**/*", "scripts/**/*", "vite.config.mts"],
  "exclude": ["node_modules", "build"]
}
