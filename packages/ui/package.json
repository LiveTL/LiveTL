{
  "name": "@livetl/ui",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./Button": {
      "types": "./dist/Button.svelte.d.ts",
      "import": "./dist/Button.js"
    },
    "./Icon": {
      "types": "./dist/Icon.svelte.d.ts",
      "import": "./dist/Icon.js"
    },
    "./IconButton": {
      "types": "./dist/IconButton.svelte.d.ts",
      "import": "./dist/IconButton.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && cp src/*.svelte.d.ts dist/ && node scripts/verify-build.mjs",
    "type:check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run lint:check -- --fix",
    "lint:check": "eslint . --max-warnings=0",
    "test": "echo \"TODO: add shared UI tests\""
  },
  "dependencies": {
    "smelte": "1.1.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "1.4.0",
    "@tsconfig/svelte": "2.0.1",
    "svelte": "3.59.2",
    "svelte-check": "2.8.1",
    "typescript": "4.7.4",
    "vite": "3.2.11"
  }
}
