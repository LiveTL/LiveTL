{
  "name": "LiveTL",
  "version": "9.0.0",
  "description": "Get live translations for YouTube and Twitch streams, crowdsourced from multilingual viewers!",
  "scripts": {
    "build": "npm run type:check && npm run build:chrome && npm run build:firefox && npm run build:mv2 && npm run verify:build",
    "build:chrome": "cross-env BROWSER=chrome vite build",
    "build:firefox": "cross-env BROWSER=firefox vite build",
    "build:mv2": "cross-env BROWSER=firefox MV=2 vite build",
    "build:production": "npm run build",
    "package": "npm run verify:build && node utils/package.js",
    "start": "npm run dev:chrome",
    "dev:chrome": "cross-env MINIFY=false BROWSER=chrome vite build --watch",
    "dev:firefox": "cross-env MINIFY=false BROWSER=firefox vite build --watch",
    "dev:mv2": "cross-env MINIFY=false BROWSER=firefox MV=2 vite build --watch",
    "ss": "node utils/screenshot.js",
    "update:list": "node utils/genlist.js",
    "type:check": "tsc -p tsconfig.json",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "jest src",
    "test:watch": "npm run test -- --watch",
    "test:e2e": "playwright test --grep-invert @live",
    "test:e2e:live": "playwright test --project=chromium-mv3 --grep @live",
    "test:e2e:ui": "playwright test --ui",
    "e2e": "npm run build && npm run test:e2e",
    "e2e:live": "npm run build:chrome && npm run test:e2e:live",
    "format": "eslint --config .eslintrc.js --cache --fix .",
    "format:check": "eslint --config .eslintrc.js .",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.15.6",
    "@fullhuman/postcss-purgecss": "^4.0.3",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-alias": "^4.0.2",
    "@sveltejs/vite-plugin-svelte": "^1.2.0",
    "@testing-library/dom": "^8.5.0",
    "@testing-library/jest-dom": "^5.11.9",
    "@testing-library/svelte": "^3.0.3",
    "@testing-library/user-event": "^13.2.1",
    "@tsconfig/svelte": "^2.0.1",
    "@types/chrome": "^0.0.154",
    "@types/jest": "26.0.24",
    "@types/youtube": "^0.0.45",
    "@typescript-eslint/eslint-plugin": "4",
    "@typescript-eslint/parser": "^4.29.1",
    "autoprefixer": "^10.3.1",
    "babel-jest": "^26.6.3",
    "cross-env": "^7.0.3",
    "eslint": "7",
    "eslint-config-standard-with-typescript": "^20.0.0",
    "eslint-plugin-import": "2",
    "eslint-plugin-node": "11",
    "eslint-plugin-promise": "4",
    "eslint-plugin-svelte3": "^3.2.0",
    "jest": "26.6.3",
    "jest-chrome": "^0.8.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.3.5",
    "postcss-extend": "^1.0.5",
    "postcss-import": "^14.0.2",
    "postinstall-postinstall": "^2.1.0",
    "request": "2.88.2",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-replace": "^2.2.0",
    "sass": "^1.32.8",
    "sha-1": "^1.0.0",
    "svelte": "^3.49.0",
    "svelte-check": "^2.8.0",
    "svelte-jester": "1.8.2",
    "svelte-preprocess": "^4.6.9",
    "svelte-waypoint": "^0.1.4",
    "tailwindcss": "^2.2.7",
    "ts-jest": "^26.5.5",
    "typescript": "^4.7.4",
    "vite": "^3.2.4",
    "vite-plugin-web-extension": "1.4.5",
    "ws": "^7.5.0",
    "xvfb": "^0.4.0"
  },
  "dependencies": {
    "@livetl/svelte-webext-stores": "^0.0.14",
    "@mdi/js": "^5.9.55",
    "dns-packet": "^5.4.0",
    "file-saver": "^2.0.5",
    "hosted-git-info": "^4.0.2",
    "html2canvas": "^1.0.0-rc.7",
    "iframe-translator": "^0.3.7",
    "is-dark-color": "^1.2.0",
    "jquery": "^3.6.0",
    "jquery-ui-bundle": "^1.12.1-migrate",
    "postcss-input-range": "^4.0.0",
    "postcss-url": "^10.1.3",
    "reconnecting-eventsource": "^1.1.0",
    "smelte": "^1.1.8",
    "svelte-materialify": "0.3.6",
    "tailwindcss-elevation": "^1.0.1",
    "youtube-iframe": "^1.0.3",
    "yt-iframe-noremote": "^1.0.0"
  }
}
