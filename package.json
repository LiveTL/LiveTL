{
  "name": "livetl-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "overrides": {
    "svelte": "3.59.2",
    "@mdi/js": "6.9.96",
    "iframe-translator": "0.3.8"
  },
  "scripts": {
    "build": "npm run build -w @livetl/livetl",
    "build:chrome": "npm run build:chrome -w @livetl/livetl",
    "build:firefox": "npm run build:firefox -w @livetl/livetl",
    "build:mv2": "npm run build:mv2 -w @livetl/livetl",
    "build:production": "npm run build:production -w @livetl/livetl",
    "check": "npm run check -w @livetl/livetl",
    "test": "npm run test -w @livetl/livetl",
    "format": "npm run format -w @livetl/livetl",
    "format:check": "npm run format:check -w @livetl/livetl",
    "package": "npm run package -w @livetl/livetl",
    "start": "npm run start -w @livetl/livetl",
    "dev:chrome": "npm run dev:chrome -w @livetl/livetl",
    "dev:firefox": "npm run dev:firefox -w @livetl/livetl",
    "dev:mv2": "npm run dev:mv2 -w @livetl/livetl",
    "e2e": "npm run e2e -w @livetl/livetl",
    "ss": "npm run ss -w @livetl/livetl",
    "update:list": "npm run update:list -w @livetl/livetl",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "8.0.1"
  }
}
